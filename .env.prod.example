# Production template (copy to deployment secret store, do not commit real secrets)
APP_ENV=production
HOST=0.0.0.0
PORT=8000
API_BIND_PORT=8000
WEB_BIND_PORT=5173
PROM_BIND_PORT=9090
ALERTMGR_BIND_PORT=9093
GRAFANA_BIND_PORT=3001

# Only production frontend origins. No wildcard.
ALLOWED_ORIGINS=https://dash.envidicy.kz
FRONTEND_BASE_URL=https://dash.envidicy.kz
NEXT_PUBLIC_API_BASE=/api/backend
NEXT_PUBLIC_ENABLE_TOKEN_LOGIN=false

ACCOUNT_CONFIG_PATH=./accounts.json
# Render persistent disk must be mounted at /var/data before production deploy.
BUDGETS_DB_PATH=/var/data/budgets.db
# Required before any provider is connected/reconnected. Store a JSON map of
# key ids to URL-safe base64 encoded 32-byte AES keys in the deployment secret
# manager. Keep old keys present until application-level rotation completes.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEYS=
INTEGRATION_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=

AUTH_COOKIE_NAME=ops_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
OAUTH_NONCE_COOKIE_NAME=ops_oauth_nonce

# Session policy
OAUTH_STATE_TTL_MINUTES=10
OAUTH_SESSION_TTL_MINUTES=480
OAUTH_SESSION_REFRESH_TTL_MINUTES=480

# CSRF
CSRF_COOKIE_NAME=ops_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_ENFORCE_COOKIE_AUTH=true

# Auth route rate limits
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_AUTH_MAX_REQUESTS=60
AUTH_RATE_LIMIT_INVITE_MAX_REQUESTS=30
AUTH_RATE_LIMIT_ADMIN_INVITE_MAX_REQUESTS=30
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true
OBSERVABILITY_PUBLIC=false
# Long random service token. For compose, put the exact same value in
# ./storage/metrics_token (one line, no surrounding quotes).
METRICS_BEARER_TOKEN=
ENABLE_TEST_ENDPOINTS=false
API_DOCS_ENABLED=false

# Automatic ad-account synchronization for a single Render web instance.
# For multiple instances the shared SQLite lease still prevents overlap, but a
# dedicated external cron/worker is preferable.
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_INITIAL_DELAY_SECONDS=10
SYNC_SCHEDULER_INTERVAL_SECONDS=300
AD_SYNC_DUE_BATCH_SIZE=10
AD_SYNC_STALE_AFTER_HOURS=24
AD_SYNC_LEASE_SECONDS=900
AD_SYNC_RUN_LEASE_SECONDS=1800
AD_SYNC_INITIAL_LOOKBACK_DAYS=180
AD_SYNC_INCREMENTAL_OVERLAP_DAYS=3
LOGIN_AUTO_SYNC_ENABLED=false

# Optional external Render Cron fallback. Generate a long random secret and
# send it in X-Sync-Cron-Secret to POST /ad-accounts/sync/due.
SYNC_CRON_ENABLED=false
SYNC_CRON_SECRET=

# Optional fallback account IDs (comma-separated)
META_ACCOUNT_IDS=
GOOGLE_CUSTOMER_IDS=
TIKTOK_ADVERTISER_IDS=

# Provider API credentials
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_REQUIRED_PERMISSIONS=ads_read
# Disabled-by-default provider money writes. Provision a dedicated random
# preview secret (>=32 bytes) in the deployment secret manager before enabling.
META_BUDGET_COMMANDS_ENABLED=false
META_BUDGET_PREVIEW_SECRET=
META_BUDGET_PREVIEW_TTL_SECONDS=300
META_BUDGET_ALLOWED_CLIENT_IDS=
META_BUDGET_ALLOW_ALL_CLIENTS=false
META_BUDGET_UNKNOWN_SETTLEMENT_SECONDS=600
META_BUDGET_ADMIN_WRITES_ENABLED=false
# Keep false for the initial campaign/ad-set release.
META_BUDGET_SPEND_CAP_ENABLED=false
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
TIKTOK_ACCESS_TOKEN=

# Meta Ads connection (Facebook Login for Business)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://dash.envidicy.kz/api/backend/auth/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_LOGIN_LEGACY_CONFIG_IDS=

# Ordinary Facebook platform login. These values may use the same Meta App as
# the Business Login values above; purpose separation is enforced by OAuth intent.
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_AUTH_REDIRECT_URI=https://dash.envidicy.kz/api/backend/auth/facebook/callback

# Optional legacy Facebook App migration. Disabled only while all values are empty;
# any partial configuration fails closed.
# When enabled, unknown primary identities cannot auto-create a workspace;
# they must prove the already-linked legacy subject with intent=migrate.
# Set all three values together during rollout. The expected legacy callback is:
# https://dash.envidicy.kz/api/backend/auth/facebook/callback
FACEBOOK_AUTH_LEGACY_CLIENT_ID=
FACEBOOK_AUTH_LEGACY_CLIENT_SECRET=
FACEBOOK_AUTH_LEGACY_REDIRECT_URI=

# Google platform login / Ads connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dash.envidicy.kz/api/backend/auth/google/callback

# Observability dashboards
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
