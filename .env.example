APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional file path with accounts list
ACCOUNT_CONFIG_PATH=./accounts.json
BUDGETS_DB_PATH=./storage/budgets.db
FRONTEND_BASE_URL=http://localhost:5173
AUTH_COOKIE_NAME=ops_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
OAUTH_NONCE_COOKIE_NAME=ops_oauth_nonce
OAUTH_STATE_TTL_MINUTES=10
OAUTH_SESSION_TTL_MINUTES=1440
OAUTH_SESSION_REFRESH_TTL_MINUTES=1440
CSRF_COOKIE_NAME=ops_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_ENFORCE_COOKIE_AUTH=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_AUTH_MAX_REQUESTS=60
AUTH_RATE_LIMIT_INVITE_MAX_REQUESTS=30
AUTH_RATE_LIMIT_ADMIN_INVITE_MAX_REQUESTS=30
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true
OBSERVABILITY_PUBLIC=true
ENABLE_TEST_ENDPOINTS=true
API_DOCS_ENABLED=true

# Scheduled ad-account sync. The in-process scheduler is suitable for the
# current single Render web instance. Keep it disabled in test environments.
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULER_INITIAL_DELAY_SECONDS=10
SYNC_SCHEDULER_INTERVAL_SECONDS=300
AD_SYNC_DUE_BATCH_SIZE=10
AD_SYNC_STALE_AFTER_HOURS=24
AD_SYNC_LEASE_SECONDS=900
AD_SYNC_RUN_LEASE_SECONDS=1800
AD_SYNC_INITIAL_LOOKBACK_DAYS=180
AD_SYNC_INCREMENTAL_OVERLAP_DAYS=3
LOGIN_AUTO_SYNC_ENABLED=true

# Optional external Render Cron fallback for POST /ad-accounts/sync/due.
SYNC_CRON_ENABLED=false
SYNC_CRON_SECRET=

# Optional fallback account IDs (comma-separated)
META_ACCOUNT_IDS=
META_BUSINESS_IDS=
GOOGLE_CUSTOMER_IDS=
TIKTOK_ADVERTISER_IDS=

# Meta
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# TikTok
TIKTOK_ACCESS_TOKEN=

# WhatsApp phone verification for self-service registration.
# Use a dedicated random value (at least 24 characters) for the HMAC secret.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=phone_verification
WHATSAPP_TEMPLATE_LANGUAGE=ru
WHATSAPP_VERIFICATION_SECRET=
WHATSAPP_CODE_TTL_SEC=600
WHATSAPP_CODE_RESEND_SEC=60
WHATSAPP_CODE_MAX_ATTEMPTS=5

# OAuth login providers (platform access)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
