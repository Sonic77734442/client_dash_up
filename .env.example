APP_ENV=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional file path with accounts list
ACCOUNT_CONFIG_PATH=./accounts.json
# Explicit backend selection prevents an injected DATABASE_URL from switching
# storage unexpectedly. Use postgresql only after migrations and smoke checks.
DATABASE_BACKEND=sqlite
DATABASE_URL=
DATABASE_AUTO_MIGRATE=true
BUDGETS_DB_PATH=./storage/budgets.db
# JSON map of non-secret key ids to URL-safe base64 encoded 32-byte AES keys.
# Leave both values empty only for legacy read-only startup. New persistent
# provider credential and stored OAuth client-secret writes fail closed until
# both are configured. The two payload types use independent crypto domains.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEYS=
INTEGRATION_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=
FRONTEND_BASE_URL=http://localhost:5173
AUTH_COOKIE_NAME=ops_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
OAUTH_NONCE_COOKIE_NAME=ops_oauth_nonce
OAUTH_STATE_TTL_MINUTES=10
OAUTH_SESSION_TTL_MINUTES=1440
OAUTH_SESSION_REFRESH_TTL_MINUTES=1440
CSRF_COOKIE_NAME=ops_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_ENFORCE_COOKIE_AUTH=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_AUTH_MAX_REQUESTS=60
AUTH_RATE_LIMIT_INVITE_MAX_REQUESTS=30
AUTH_RATE_LIMIT_ADMIN_INVITE_MAX_REQUESTS=30
REQUEST_LOG_ENABLED=true
METRICS_ENABLED=true
OBSERVABILITY_PUBLIC=true
ENABLE_TEST_ENDPOINTS=true
API_DOCS_ENABLED=true

# Scheduled ad-account sync. The in-process scheduler is suitable for the
# current single Render web instance. Keep it disabled in test environments.
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULER_INITIAL_DELAY_SECONDS=10
SYNC_SCHEDULER_INTERVAL_SECONDS=300
AD_SYNC_DUE_BATCH_SIZE=10
AD_SYNC_STALE_AFTER_HOURS=24
AD_SYNC_LEASE_SECONDS=900
AD_SYNC_RUN_LEASE_SECONDS=1800
AD_SYNC_INITIAL_LOOKBACK_DAYS=180
AD_SYNC_INCREMENTAL_OVERLAP_DAYS=3
LOGIN_AUTO_SYNC_ENABLED=true

# Optional external Render Cron fallback for POST /ad-accounts/sync/due.
SYNC_CRON_ENABLED=false
SYNC_CRON_SECRET=

# Optional fallback account IDs (comma-separated)
META_ACCOUNT_IDS=
META_BUSINESS_IDS=
GOOGLE_CUSTOMER_IDS=
TIKTOK_ADVERTISER_IDS=

# Meta
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Required Business Login permissions checked both by debug_token and /me/permissions.
# Read-only sync requires ads_read (ads_management also satisfies it). Add
# ads_management only when provider budget controls are reviewed and enabled;
# add business_management only when META_BUSINESS_IDS enumeration is used.
META_REQUIRED_PERMISSIONS=ads_read

# Provider budget controls are dormant unless explicitly enabled. Use a
# dedicated random secret of at least 32 bytes; never reuse OAuth, cookie,
# CSRF, Meta App, or credential-encryption secrets.
META_BUDGET_COMMANDS_ENABLED=false
META_BUDGET_PREVIEW_SECRET=
META_BUDGET_PREVIEW_TTL_SECONDS=300
# Default-deny pilot rollout. Add exact client UUIDs, or explicitly opt into
# all clients only after production review.
META_BUDGET_ALLOWED_CLIENT_IDS=
META_BUDGET_ALLOW_ALL_CLIENTS=false
META_BUDGET_UNKNOWN_SETTLEMENT_SECONDS=600
META_BUDGET_ADMIN_WRITES_ENABLED=false
# Separate high-blast-radius gate; the generic flag cannot enable spend caps.
META_BUDGET_SPEND_CAP_ENABLED=false

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# TikTok
TIKTOK_ACCESS_TOKEN=

# OAuth login providers (platform access)
# FACEBOOK_AUTH_* may intentionally contain the same Meta App credentials as
# FACEBOOK_* below; login and advertising authorization remain separate flows.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=
# Temporary comma-separated read-sync compatibility during a controlled
# Business Login Configuration migration. New connects and provider writes
# always require FACEBOOK_LOGIN_CONFIG_ID. Remove after every tenant reconnects.
FACEBOOK_LOGIN_LEGACY_CONFIG_IDS=
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/facebook/callback
# Optional, disabled only while all three values are empty. Any partial
# configuration fails closed. During an App ID migration,
# unknown primary subjects are blocked until they prove the linked legacy
# subject through /auth/facebook/start?intent=migrate.
FACEBOOK_AUTH_LEGACY_CLIENT_ID=
FACEBOOK_AUTH_LEGACY_CLIENT_SECRET=
FACEBOOK_AUTH_LEGACY_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional Envidicy ID + My integration; preparation does not enable production.
# Canonical client envidicy-dash; launch https://dash.envidicy.kz/auth/envidicy.
# See docs/contracts/dash-consumer-v1.md before migrations, mapping and activation.
ENVIDICY_ID_ENABLED=false
# Optional automatic browser entry through ID; does not close legacy login.
# Enable only for the verified pilot. ID-only mode also enables automatic entry.
ENVIDICY_ID_AUTO_LOGIN_ENABLED=false
# Enable only after verified identity/data migration, My rights and cutover acceptance.
# Closes legacy human login/sessions; never use this to test an unready deployment.
ENVIDICY_ID_ONLY_ENABLED=false
# Before enabling a test-only pilot, set this backend-only JSON array to the
# verified subjects of separate test identities (never emails/legacy owners).
# ENVIDICY_ID_PILOT_SUBJECTS=["verified-test-subject"]
# Absent = unrestricted ID cohort; present but empty/invalid = ID fails closed.
# Remove only after real identity mappings and rollout acceptance are complete.
# Choose direct secret OR protected file for each credential, never both.
# Backend only: never expose these through NEXT_PUBLIC_* or commit real values.
ENVIDICY_ID_CLIENT_SECRET=
ENVIDICY_ID_CLIENT_SECRET_FILE=
ENVIDICY_MY_AUTHORITY_TOKEN=
ENVIDICY_MY_AUTHORITY_TOKEN_FILE=
