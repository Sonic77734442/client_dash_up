[Unit]
Description=Envidicy Dashboard Stack (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/envidicy-dashboard
Environment=PROD_ENV_FILE=/opt/envidicy-dashboard/.env.prod
ExecStart=/usr/bin/docker compose --env-file /opt/envidicy-dashboard/.env.prod -f docker-compose.prod.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file /opt/envidicy-dashboard/.env.prod -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
